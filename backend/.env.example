# Copia a backend/.env
PORT=3000

# MongoDB local
MONGO_URI=mongodb://localhost:27017/sts

# MongoDB Atlas (cambia unicamente MONGO_URI)
# MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/sts?retryWrites=true&w=majority

# Seed automatico al arrancar si la BD esta vacia
AUTO_SEED=true

# Copia a backend/.env
PORT=3000

# MongoDB local (docker compose up -d)
MONGO_URI=mongodb://localhost:27017/sts

# MongoDB Atlas (cambia únicamente MONGO_URI)
# MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/sts?retryWrites=true&w=majority

# Seed automático al arrancar si la BD está vacía
AUTO_SEED=true
